{
  "name": "@nap-sft/tablsx",
  "version": "0.2.0",
  "description": "A Node.js library for reading and writing Excel .xlsx files",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src/ test/ examples/",
    "lint:fix": "eslint src/ test/ examples/ --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "check:headers": "grep -rL --include='*.js' --include='*.ts' '// Copyright © 2026 – present NapSoft LLC. All rights reserved.' src test examples | { ! grep .; }",
    "format": "prettier --write '{src,test,examples}/**/*.{js,ts}' 'docs/**/*.md'",
    "format:check": "prettier --check '{src,test,examples}/**/*.{js,ts}' 'docs/**/*.md'",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "homepage": "https://silverstone-i.github.io/tablsx/",
  "repository": {
    "type": "git",
    "url": "https://github.com/silverstone-i/tablsx.git"
  },
  "bugs": {
    "url": "https://github.com/silverstone-i/tablsx/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fast-xml-parser": "^5.5.6",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^18.19.130",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitepress": "^2.0.0-alpha.12",
    "vitest": "^3.1.1"
  }
}
